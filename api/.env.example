# Environment Variables for Contact Form API
# Copy this file to .env and fill in your actual values

# Email Configuration
CONTACT_EMAIL=your-email@yourdomain.com

# SMTP Configuration (recommended for production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_ENCRYPTION=tls

# Application Environment
APP_ENV=production

# Security (optional - for additional security)
ALLOWED_ORIGIN_1=https://yourdomain.com
ALLOWED_ORIGIN_2=https://www.yourdomain.com

# Notes:
# - For Gmail: Use App Password, not your regular password
# - Enable 2-Factor Authentication before generating App Password
# - Never commit the actual .env file to version control
# - Set proper file permissions: chmod 600 .env
