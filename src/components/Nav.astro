---
const links = [
  { href: '/', label: 'home' },
  { href: '/about', label: 'about' },
  { href: '/experience', label: 'experience' },
  { href: '/projects', label: 'projects' },
  { href: '/contact', label: 'contact' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="bar">
  <div class="container inner">
    <a href="/" class="brand">jakaria.dev</a>
    <nav class="links" aria-label="Primary">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={['link', { active: (l.href.replace(/\/$/, '') || '/') === current }]}
            aria-current={(l.href.replace(/\/$/, '') || '/') === current ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding-block: var(--sp-3);
  }
  .brand {
    font-family: var(--ff-mono);
    font-size: var(--fs-sm);
    color: var(--text);
  }
  .links {
    display: flex;
    gap: var(--sp-4);
  }
  .link {
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-mono);
    color: var(--text-muted);
    transition: color var(--dur) var(--ease);
  }
  .link:hover,
  .link.active {
    color: var(--accent);
  }
  /* Mobile menu island lands in Phase 3; simple wrap for now. */
  @media (max-width: 560px) {
    .links {
      gap: var(--sp-3);
    }
    .link:first-child {
      display: none;
    }
  }
</style>
