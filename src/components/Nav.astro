---
const links = [
  { href: '/', label: 'home' },
  { href: '/about', label: 'about' },
  { href: '/experience', label: 'experience' },
  { href: '/projects', label: 'projects' },
  { href: '/contact', label: 'contact' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="bar">
  <div class="container inner">
    <a href="/" class="brand">jakaria.dev</a>
    <button
      class="toggle"
      id="nav-toggle"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="nav-links"
    >
      <span></span><span></span><span></span>
    </button>
    <nav class="links" id="nav-links" aria-label="Primary">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={['link', { active: (l.href.replace(/\/$/, '') || '/') === current }]}
            aria-current={(l.href.replace(/\/$/, '') || '/') === current ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    links?.classList.toggle('open', !open);
  });
  // Close after navigating (mobile).
  links?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      links.classList.remove('open');
    }),
  );
</script>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding-block: var(--sp-3);
  }
  .brand {
    font-family: var(--ff-mono);
    font-size: var(--fs-sm);
    color: var(--text);
  }
  .links {
    display: flex;
    gap: var(--sp-4);
  }
  .link {
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: capitalize;
    color: var(--text-muted);
    transition: color var(--dur) var(--ease);
  }
  .link:hover,
  .link.active {
    color: var(--accent);
  }

  /* Hamburger toggle — hidden on desktop. */
  .toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0;
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    cursor: pointer;
  }
  .toggle span {
    display: block;
    width: 18px;
    height: 1.5px;
    margin-inline: auto;
    background: var(--text);
    transition: transform var(--dur) var(--ease);
  }

  @media (max-width: 560px) {
    .toggle {
      display: flex;
    }
    .links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: var(--sp-4);
      padding: var(--sp-6) var(--gutter);
      background: var(--bg-elev);
      border-bottom: 1px solid var(--border);
      display: none;
    }
    .links.open {
      display: flex;
    }
    .link {
      font-size: var(--fs-sm);
    }
  }
</style>
