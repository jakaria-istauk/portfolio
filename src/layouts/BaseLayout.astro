---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, pageLabels } from '../data/site';

export interface Props {
  title: string;
  description?: string;
  /** Path-relative slug used for canonical + og:url, e.g. "/about". */
  path?: string;
  /** Page-specific OG image (path-absolute); falls back to site default. */
  ogImage?: string;
  ogImageAlt?: string;
  /** og:type — "website" (default) or "profile" for the home/about pages. */
  ogType?: string;
  /** Extra JSON-LD nodes to merge into the page @graph (e.g. project entities). */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  path = Astro.url.pathname,
  ogImage = site.ogImage,
  ogImageAlt = site.ogImageAlt,
  ogType = 'website',
  jsonLd = [],
} = Astro.props;

const siteName = site.name;
// Normalize to a trailing slash so canonical/og:url match the sitemap and the
// directory-format served URLs (e.g. /about/), avoiding duplicate-URL signals.
const canonicalPath = path.endsWith('/') ? path : `${path}/`;
const canonical = new URL(canonicalPath, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const origin = new URL(Astro.site!).origin;

// --- JSON-LD @graph ---------------------------------------------------------
// Stable @id anchors let nodes reference each other across pages.
const personId = `${origin}/#person`;
const websiteId = `${origin}/#website`;

const person = {
  '@type': 'Person',
  '@id': personId,
  name: site.name,
  jobTitle: site.jobTitle,
  description: site.description,
  url: `${origin}/`,
  email: `mailto:${site.email}`,
  address: {
    '@type': 'PostalAddress',
    addressCountry: site.location.country,
    addressLocality: site.location.locality,
  },
  sameAs: [...site.sameAs],
};

const website = {
  '@type': 'WebSite',
  '@id': websiteId,
  url: `${origin}/`,
  name: siteName,
  description: site.description,
  inLanguage: 'en',
  publisher: { '@id': personId },
};

// Breadcrumb trail derived from the path (Home → …segments).
const segments = path.replace(/^\/|\/$/g, '').split('/').filter(Boolean);
const crumbs = [{ label: pageLabels[''], href: `${origin}/` }];
let acc = origin;
for (const seg of segments) {
  acc += `/${seg}`;
  crumbs.push({ label: pageLabels[seg] ?? seg, href: acc });
}
const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    item: c.href,
  })),
};

const graph = {
  '@context': 'https://schema.org',
  '@graph': [person, website, breadcrumb, ...jsonLd],
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteName} />
    <link rel="canonical" href={canonical} />

    <!-- OpenGraph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      />
    </noscript>

    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
