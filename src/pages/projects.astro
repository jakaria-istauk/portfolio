---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const plugins = all.filter((p) => p.data.type === 'plugin');
const oss = all.filter((p) => p.data.type !== 'plugin');

// One structured node per project. Plugins/apps → SoftwareApplication;
// other OSS → CreativeWork. Authored/maintained by the site Person.
const origin = new URL(Astro.site!).origin;
const projectLd = all.map((p) => ({
  '@type': p.data.type === 'oss' ? 'CreativeWork' : 'SoftwareApplication',
  name: p.data.name,
  description: p.data.blurb,
  ...(p.data.type !== 'oss'
    ? { applicationCategory: 'WordPress plugin', operatingSystem: 'WordPress' }
    : {}),
  ...(p.data.stack.length ? { keywords: p.data.stack.join(', ') } : {}),
  ...(p.data.liveUrl ? { url: p.data.liveUrl } : {}),
  ...(p.data.repoUrl ? { codeRepository: p.data.repoUrl } : {}),
  author: { '@id': `${origin}/#person` },
}));

const description =
  'WordPress plugins running on millions of sites, plus open-source developer tooling — Tablentor, Essential Addons for Elementor, strata, and more, authored or maintained by Jakaria Istauk.';
---

<BaseLayout
  title="Projects — Jakaria Istauk"
  description={description}
  path="/projects"
  jsonLd={projectLd}
>
  <section class="container head">
    <p class="eyebrow">Projects</p>
    <h1>Plugins &amp; open source.</h1>
    <p class="lead">
      WordPress plugins running on millions of sites, plus open-source developer
      tooling. Everything below is code I authored or contribute to core.
    </p>
  </section>

  <section class="container block">
    <h2>WordPress plugins</h2>
    <div class="grid">
      {
        plugins.map((p) => (
          <ProjectCard
            name={p.data.name}
            role={p.data.role}
            blurb={p.data.blurb}
            installs={p.data.installs}
            contributions={p.data.contributions}
            stack={p.data.stack}
            liveUrl={p.data.liveUrl}
            repoUrl={p.data.repoUrl}
            type={p.data.type}
          />
        ))
      }
    </div>
  </section>

  <section class="container block">
    <h2>Open source</h2>
    <div class="grid">
      {
        oss.map((p) => (
          <ProjectCard
            name={p.data.name}
            role={p.data.role}
            blurb={p.data.blurb}
            installs={p.data.installs}
            contributions={p.data.contributions}
            stack={p.data.stack}
            liveUrl={p.data.liveUrl}
            repoUrl={p.data.repoUrl}
            type={p.data.type}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .head {
    padding-block: var(--sp-16) var(--sp-8);
  }
  h1 {
    font-size: var(--fs-4xl);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--sp-4);
  }
  .lead {
    font-size: var(--fs-lg);
    color: var(--text-muted);
    max-width: 52ch;
    margin: 0;
  }
  .block {
    padding-block: var(--sp-12);
  }
  h2 {
    font-size: var(--fs-2xl);
    letter-spacing: var(--tracking-tight);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--border);
    margin: 0 0 var(--sp-8);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--sp-8);
  }
</style>
